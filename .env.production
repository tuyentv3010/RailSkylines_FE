# Giá trị PRODUCTION cho FE — Next.js tự đọc lúc `next build`.
# NEXT_PUBLIC_* là PUBLIC (nhúng vào bundle trình duyệt) → không phải secret, commit được.
# ⚠️ Sửa domain FE + redirect URI cho đúng nếu khác.
NEXT_PUBLIC_API_ENDPOINT=https://railskylines-api.inova.id.vn
NEXT_PUBLIC_URL=https://railskylines.inova.id.vn
NEXT_PUBLIC_GOOGLE_CLIENT_ID=536487413928-4kce5bm4lnj8f86pjju7q6qt11jlv4hb.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_AUTHORIZED_REDIRECT_URI=https://railskylines.inova.id.vn/oauth/google/callback
